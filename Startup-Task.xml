<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.3" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Launches Startup.ahk (merged AutoHotkey scripts) at logon.</Description>
    <URI>\AHK Startup Scripts</URI>
  </RegistrationInfo>
  <Principals>
    <Principal id="Author">
      <UserId>S-1-5-21-1446800710-3678226934-2249616184-1003</UserId>
      <LogonType>InteractiveToken</LogonType>
      <!-- Elevated so UIPI doesn't kill the hotkeys when an admin app has focus. -->
      <RunLevel>HighestAvailable</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <StartWhenAvailable>true</StartWhenAvailable>
    <IdleSettings>
      <Duration>PT10M</Duration>
      <WaitTimeout>PT1H</WaitTimeout>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <UseUnifiedSchedulingEngine>true</UseUnifiedSchedulingEngine>
  </Settings>
  <Triggers>
    <LogonTrigger>
      <UserId>LAPTOP-RCTNUJ9U\Atharva Sawant</UserId>
    </LogonTrigger>
  </Triggers>
  <Actions Context="Author">
    <Exec>
      <Command>C:\Program Files\AutoHotkey\v2\AutoHotkey64.exe</Command>
      <Arguments>"C:\Users\Atharva Sawant\Documents\AutoHotKey\Startup.ahk"</Arguments>
      <WorkingDirectory>C:\Users\Atharva Sawant\Documents\AutoHotKey</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
