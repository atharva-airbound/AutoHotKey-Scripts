# Local Claude Code permissions — machine-specific, not shared config.
# Leading **/ matters: a pattern containing a slash is anchored to this file's
# directory, so a bare ".claude/..." would miss scripts/.claude/ and friends.
**/.claude/settings.local.json

# AHK compiler output
*.exe

# Alt+Tab capture corpus — large screenshots of whatever happened to be on
# screen, regenerated on demand by Probe-Capture-AltTab.py.
alttab-corpus/

# AltTabGrid.ahk standalone-test output: a log and the raw PrintWindow render,
# both screen content and both regenerated by re-running the test.
atg-test.log
atg-render.bmp
atg-timing.log
atg-trace.log
atg-selfail.bmp
# Annotated output from Probe-Grid-AltTab.py. Ignored locally by a *.png rule in
# .git/info/exclude, but that is not shared, so name them here too.
atg-*-detected.png
